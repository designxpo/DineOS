# API
PORT=4000
LOG_LEVEL=info
# App role: subject to row-level security. Never give it BYPASSRLS.
DATABASE_URL=postgres://dineos_app:dineos_app_dev@localhost:5432/mezmitra_dev
# Platform admin role: BYPASSRLS, only used by /v1/admin routes and background jobs.
DATABASE_ADMIN_URL=postgres://dineos_admin:dineos_admin_dev@localhost:5432/mezmitra_dev
# Owner/superuser: runs migrations and db:setup. Must be superuser or have BYPASSRLS.
DATABASE_OWNER_URL=postgres://localhost:5432/mezmitra_dev
MEZMITRA_APP_PASSWORD=dineos_app_dev
MEZMITRA_ADMIN_PASSWORD=dineos_admin_dev

# Signs table QR codes and guest tokens. 32+ random characters. Rotating it invalidates every printed QR.
TOKEN_SECRET=change-me-to-32-plus-random-characters-please

# Where guests land after scanning. {slug} and {token} are substituted.
GUEST_URL_TEMPLATE=http://localhost:3000/t/{token}
CORS_ORIGINS=http://localhost:3000

# Optional: enables Socket.IO fan-out across several API nodes.
REDIS_URL=

# fs (default, files under STORAGE_DIR served at /files) or s3 (MinIO or any S3-compatible store)
STORAGE_DRIVER=fs
STORAGE_DIR=./storage
PUBLIC_API_URL=http://localhost:4000
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Optional: the Talko AI link (WhatsApp, Instagram, Messenger and web chat). Both must be set.
# INTEGRATION_ENC_KEY encrypts the keys Talko gives us: 32+ random characters; changing it means
# owners reconnect. TALKO_API_URL is Talko's address (https in production); every tenant's events
# go there, never to an address a tenant typed.
INTEGRATION_ENC_KEY=
TALKO_API_URL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
