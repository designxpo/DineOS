{
  "name": "@mezmitra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:setup": "tsx src/scripts/db-setup.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:codegen": "tsx src/scripts/codegen.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "demo:photos": "tsx src/scripts/demo-photos.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "tenant:purge": "tsx src/scripts/purge-tenant.ts",
    "demo:video": "node --import tsx src/scripts/seed.ts --video"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@mezmitra/shared": "*",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/functions": "^3.10.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "ioredis": "^5.8.2",
    "kysely": "^0.29.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "ioredis-mock": "^8.13.1",
    "kysely-codegen": "^0.20.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15"
  }
}
