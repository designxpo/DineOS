{
  "name": "@dineos/print-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "On-site agent: receives kitchen tickets and bills from DineOS and prints them on ESC/POS network printers",
  "bin": {
    "dineos-print-agent": "dist/main.js"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:download": "tsup && node -e \"const fs=require('fs');fs.mkdirSync('../web/public/agent',{recursive:true});fs.copyFileSync('dist/download/dineos-agent.mjs','../web/public/agent/dineos-agent.mjs')\""
  },
  "dependencies": {
    "@dineos/shared": "*",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.15"
  }
}
