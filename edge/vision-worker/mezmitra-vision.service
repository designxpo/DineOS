# systemd unit for the camera box. Copy to /etc/systemd/system/, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now mezmitra-vision
[Unit]
Description=Mezmitra table vision worker
After=network-online.target
Wants=network-online.target

[Service]
User=mezmitra
WorkingDirectory=/opt/mezmitra-vision
EnvironmentFile=/etc/mezmitra-vision.env
ExecStart=/opt/mezmitra-vision/venv/bin/python -m mezmitra_vision
Restart=always
RestartSec=5
# The worker needs the network and its model; nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
