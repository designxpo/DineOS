# Copy to .env.production and fill in. Generate secrets with: openssl rand -hex 32
APP_DOMAIN=app.dineos.in
API_DOMAIN=api.dineos.in

POSTGRES_PASSWORD=
DINEOS_APP_PASSWORD=
DINEOS_ADMIN_PASSWORD=
# Signs table QR codes and guest tokens. Changing it invalidates every printed QR code.
TOKEN_SECRET=

# fs keeps menu photos on the server's volume; s3 uses MinIO or any S3-compatible bucket you own.
STORAGE_DRIVER=fs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Backups: keep this passphrase outside the server (password manager). Without it backups are unreadable.
BACKUP_PASSPHRASE=
# A second location you own: an rsync/ssh target or an S3-compatible bucket.
BACKUP_RSYNC_TARGET=
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
