# Copy to .env.production and fill in. Generate secrets with: openssl rand -hex 32
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=
MEZMITRA_APP_PASSWORD=
MEZMITRA_ADMIN_PASSWORD=
# Signs table QR codes and guest tokens. Changing it invalidates every printed QR code.
TOKEN_SECRET=
# Redis password (hex, so it fits in the connection URL): openssl rand -hex 32
REDIS_PASSWORD=

# fs keeps menu photos on the server's volume; s3 uses MinIO or any S3-compatible bucket you own.
# With the bundled MinIO (docker-compose.s3.yml) the key pair below is also its admin login: use
# long random values (openssl rand -hex 32), never defaults.
STORAGE_DRIVER=fs
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Backups: keep this passphrase outside the server (password manager). Without it backups are unreadable.
BACKUP_PASSPHRASE=
# A second location you own: an rsync/ssh target or an S3-compatible bucket.
BACKUP_RSYNC_TARGET=
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# Optional: the Talko AI link (WhatsApp, Instagram, Messenger and web chat). Both must be set.
# INTEGRATION_ENC_KEY encrypts the keys Talko gives us: 32+ random characters; changing it means
# owners reconnect. TALKO_API_URL is Talko's address (https in production); every tenant's events
# go there, never to an address a tenant typed.
INTEGRATION_ENC_KEY=
TALKO_API_URL=

# Optional: Razorpay, so restaurants can upgrade their plan and pay online (our own account).
# Dashboard → API keys for the key id and secret. Dashboard → Webhooks: add
# https://<your-domain>/v1/plan/razorpay/webhook with payment.captured, order.paid and
# payment.failed, and paste its secret below. Without them, the plans page asks owners to contact support.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
